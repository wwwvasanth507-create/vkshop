# ==========================================
# Git Ignore Rules for VKShop / E-Commerce App
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
secrets.json
credentials.json
*.cloudflared.json

# ------------------------------------------
# Python Virtual Environments
# ------------------------------------------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Python Bytecode & Cache
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------
# Testing, Coverage & Linting
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache
nosetests.xml
coverage.xml

# ------------------------------------------
# Databases & Storage Files
# ------------------------------------------
database/*
!database/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-journal

# ------------------------------------------
# Application Logs & Runtime Traces
# ------------------------------------------
logs/*
!logs/.gitkeep
*.log
gunicorn.log
access.log
error.log

# ------------------------------------------
# Database Backups & Export Dumps
# ------------------------------------------
backups/*
!backups/.gitkeep
*.bak
*.sql
*.dump
*.tar.gz
ecommerce_backup_*.json

# ------------------------------------------
# User Dynamic Uploads
# ------------------------------------------
static/uploads/**
!static/uploads/
!static/uploads/**/
!static/uploads/**/.gitkeep


# ------------------------------------------
# Temporary & Scratch Files
# ------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.swp

# ------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.history/
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Operating System Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# Node / Frontend Build (if applicable)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

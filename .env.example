# ==========================================
# VKShop — Local Ubuntu Server Environment Setup
# ==========================================

# Core Flask Mode
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
APP_URL=http://127.0.0.1:5000

# PostgreSQL Connection (Exclusive Database for Production)
DATABASE_URL=postgresql+psycopg://vkshop_user:vkshop_secure_password@127.0.0.1:5432/ecommerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=300
DATABASE_POOL_TIMEOUT=15

# Redis Session & Cache Configuration
SESSION_TYPE=redis
REDIS_URL=redis://127.0.0.1:6379/0

# Storage Settings (Local Disk or MinIO S3 Server)
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_FALLBACK=True
# If using MinIO on local Ubuntu server:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=minio_admin_user
# S3_SECRET_KEY=minio_admin_password
# S3_BUCKET=vkshop-media

# Image Optimization Settings
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_UPLOAD_MB=15

# Gunicorn Worker Settings
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

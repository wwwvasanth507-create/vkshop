# ==============================================================================
# VKShop Production Environment Variables Template (.env.example)
# NEVER commit real passwords or access keys to Git!
# ==============================================================================

# Core Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace_with_a_secure_random_64_char_hex_key_in_production
SESSION_COOKIE_SECURE=True

# Database (PostgreSQL) Configuration
# Render automatically provides DATABASE_URL when attached to a PostgreSQL instance
DATABASE_URL=postgresql://username:password@hostname:5432/ecommerce_db
# Alternatively, configure via individual parameters:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=ecommerce
# POSTGRES_HOST=your_db_host
# POSTGRES_PORT=5432

# Redis Configuration (Optional for session & caching)
REDIS_URL=redis://127.0.0.1:6379/0

# Persistent Object Storage (S3 / Cloudflare R2 / MinIO / Supabase S3)
STORAGE_PROVIDER=s3
STORAGE_PUBLIC_URL=https://your-bucket-public-url.r2.dev

# S3 / MinIO Credentials
MINIO_ENDPOINT=your-s3-endpoint.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET_NAME=vkshop-uploads
MINIO_SECURE=True

# Production Storage Fallback Rule (MUST BE FALSE IN PRODUCTION)
ALLOW_LOCAL_STORAGE_FALLBACK=False

# Image Optimization Settings
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_UPLOAD_MB=15

# App Specific Settings
ADMIN_UPI_ID=admin@upi
SUPPORT_OFFICIAL_EMAIL=support@vkshop.com
